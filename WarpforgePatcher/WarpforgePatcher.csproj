<Project Sdk="Microsoft.NET.Sdk">
  <!-- WF Revival Patcher (formerly Warpforge Patcher; package id unchanged so installed copies update): patches the player's own copy of Warhammer 40,000: Warpforge on the phone
       itself, with the same patching code as LemonPatch.exe (../Core). See README-WarpforgePatcher.md. -->
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WarpforgePatcher</RootNamespace>
    <ApplicationId>com.silentanarchist.warpforgepatcher</ApplicationId>
    <ApplicationTitle>WF Revival Patcher</ApplicationTitle>
    <ApplicationVersion>20</ApplicationVersion>
    <ApplicationDisplayVersion>0.4.2</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- the loader package is already a zip; storing it as-is keeps the build quick -->
    <AndroidStoreUncompressedFileExtensions>.zip</AndroidStoreUncompressedFileExtensions>
    <!-- melon_data.zip: the loader package from the Android repo (patcher/tool/melon_data.zip.part0-2 joined); build.sh puts it here -->
    <MelonDataZip Condition="'$(MelonDataZip)' == ''">$(MSBuildThisFileDirectory)loader/melon_data.zip</MelonDataZip>
  </PropertyGroup>
  <!-- normally the app downloads the loader package (LoaderPackage.cs); BundleLoader=true puts it inside the app instead -->
  <ItemGroup Condition="'$(BundleLoader)' == 'true'">
    <AndroidAsset Include="$(MelonDataZip)" Link="Assets/melon_data.zip" />
  </ItemGroup>
  <!-- the app's translations: copies of the mod repo's localization/patcher/<code>.json (build.sh refreshes them) -->
  <!-- the start-up picture put into the patched game (PatchJob, LEMON_LAUNCH_SPLASH); our own art, made from the title text -->
  <ItemGroup>
    <AndroidAsset Include="Splash/launch-splash.png" Link="Assets/launch-splash.png" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="Localization/*.json" Exclude="Localization/en.json" Link="Assets/localization/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/MelonLoader.Installer.Core.csproj" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.13.1.4" />
  </ItemGroup>
</Project>
